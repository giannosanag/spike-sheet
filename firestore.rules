rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The app's owner (this Google account only) may read every account, for the admin page.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'giannosanag@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // Someone the owner removed (an entry in blocked/<uid>): no access to their own folder and no live
    // score links, until the owner gives it back. (Called only where request.auth is set.)
    function removed() {
      return exists(/databases/$(database)/documents/blocked/$(request.auth.uid));
    }
    // The owner deletes an account's data (a deletion request) only after removing its access.
    function wipeable(uid) {
      return isOwner() && exists(/databases/$(database)/documents/blocked/$(uid));
    }
    // Each Google account reads and writes only its own folder: its profile (users/<uid>), its matches and
    // its settings. The owner may read them, never change them. The profile's email is the account's own
    // (the owner's page shows it, so it is always there), and only the owner deletes a profile.
    match /users/{uid} {
      allow read: if request.auth != null && ((request.auth.uid == uid && !removed()) || isOwner());
      allow create, update: if request.auth != null && request.auth.uid == uid && !removed()
        && request.resource.data.email == request.auth.token.email;
      allow delete: if wipeable(uid);
      // Only the app's own documents: the matches and the seven settings (five players, two teams). Nothing else
      // can be stored where the owner's page, the backups and a deletion would not see it (audit 10-12).
      match /matches/{id} {
        allow read: if request.auth != null && ((request.auth.uid == uid && !removed()) || isOwner());
        allow write: if request.auth != null && request.auth.uid == uid && !removed();
        allow delete: if wipeable(uid);
      }
      match /settings/{name} {
        allow read: if request.auth != null && ((request.auth.uid == uid && !removed()) || isOwner());
        allow write: if request.auth != null && request.auth.uid == uid && !removed()
          && name in ['player', 'player2', 'player3', 'player4', 'player5', 'team', 'team2'];
        allow delete: if wipeable(uid);
      }
    }
    // The owner's list of removed people. Only the owner lists and changes it; each person may read
    // their own entry, so the app can tell them.
    match /blocked/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow list, write: if isOwner();
    }
    // A live score link: the two team names and the score only, no players. Anyone with the link's code
    // may read that one score until it ends (nobody else can list them); only the account that made it
    // writes it. The owner lists and deletes them (a deletion request, an abusive one).
    // (A code not written yet may be read too, so a link opened before the first point keeps waiting for it.)
    match /live/{code} {
      allow get: if resource == null || resource.data.until > request.time;
      allow list: if isOwner();
      allow create, update: if request.auth != null && !removed()
        && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['uid', 'home', 'opp', 'away', 'sets', 'cur', 'won', 'done', 'at', 'until'])
        && request.resource.data.home is string && request.resource.data.home.size() <= 100
        && request.resource.data.opp is string && request.resource.data.opp.size() <= 100
        && request.resource.data.away is bool && request.resource.data.done is bool && request.resource.data.cur is int
        && request.resource.data.won is list && request.resource.data.won.size() == 2
        && request.resource.data.won[0] is int && request.resource.data.won[1] is int
        && request.resource.data.sets is list && request.resource.data.sets.size() <= 9
        && request.resource.data.at is timestamp
        && request.resource.data.until is timestamp
        && request.resource.data.until < request.time + duration.value(2, 'd');
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isOwner());
    }
  }
}
