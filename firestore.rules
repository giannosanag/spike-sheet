rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The app's owner (this Google account only) may read every account, for the admin page.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'giannosanag@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // Each Google account reads and writes only its own folder: its profile (users/<uid>),
    // its matches and its settings. The owner may read them, never write them.
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // A live score link: the two team names and the score only, no players. Anyone with the link's code
    // may read that one score until it ends (nobody can list them); only the account that made it writes it.
    // (A code not written yet may be read too, so a link opened before the first point keeps waiting for it.)
    match /live/{code} {
      allow get: if resource == null || resource.data.until > request.time;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['uid', 'home', 'opp', 'away', 'sets', 'cur', 'won', 'done', 'at', 'until'])
        && request.resource.data.home is string && request.resource.data.home.size() <= 100
        && request.resource.data.opp is string && request.resource.data.opp.size() <= 100
        && request.resource.data.away is bool && request.resource.data.done is bool && request.resource.data.cur is int
        && request.resource.data.won is list && request.resource.data.won.size() == 2
        && request.resource.data.won[0] is int && request.resource.data.won[1] is int
        && request.resource.data.sets is list && request.resource.data.sets.size() <= 9
        && request.resource.data.at is timestamp
        && request.resource.data.until is timestamp
        && request.resource.data.until < request.time + duration.value(2, 'd');
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
