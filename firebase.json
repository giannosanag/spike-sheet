{
  "hosting": [
    {
      "public": ".",
      "ignore": [
        "firebase.json",
        "README.md",
        "firestore.rules",
        "**/.*"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            }
          ]
        }
      ],
      "site": "spikesheet"
    },
    {
      "public": ".",
      "ignore": [
        "firebase.json",
        "README.md",
        "firestore.rules",
        "**/.*"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            }
          ]
        }
      ],
      "site": "spike-sheet-theo"
    }
  ]
}
